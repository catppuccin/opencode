{
  "$schema": "https://opencode.ai/theme.json",
  "base": {
    "categorical": ["accent", "purple", "green", "blue", "orange", "red"],
    "text": {
      "base": "$hue.neutral.100",
      "muted": "$hue.neutral.300",
      "action": {
        "primary": {
          "base": "$text.base",
          "$disabled": "$text.muted",
          "$focused": "$text.base",
          "$selected": "$hue.interactive.400"
        },
        "secondary": {
          "base": "$text.muted",
          "$hovered": "$text.base",
          "$focused": "$hue.interactive.200"
        },
        "destructive": {
          "base": "$hue.neutral.900",
          "$disabled": "$text.muted"
        }
      },
      "formfield": {
        "base": "$text.base",
        "$hovered": "$hue.interactive.400",
        "$focused": "$hue.interactive.400",
        "$pressed": "$hue.interactive.400",
        "$disabled": "$text.muted",
        "$selected": "$hue.interactive.400"
      },
      "feedback": {
        "error": { "base": "$hue.red.400" },
        "warning": { "base": "$hue.yellow.400" },
        "success": { "base": "$hue.green.400" },
        "info": { "base": "$hue.teal.400" }
      }
    },
    "background": {
      "base": "#303446",
      "raised": {
        "base": "#292c3c",
        "high": "#232634",
        "max": "#414559"
      },
      "action": {
        "primary": {
          "base": "transparent",
          "$hovered": "$hue.neutral.700",
          "$focused": "$hue.interactive.600",
          "$selected": "transparent"
        },
        "secondary": { "base": "transparent" },
        "destructive": { "base": "$hue.red.400" }
      },
      "formfield": { "base": "$background.base" },
      "feedback": {
        "error": { "base": "$background.base" },
        "warning": { "base": "$background.base" },
        "success": { "base": "$background.base" },
        "info": { "base": "$background.base" }
      }
    },
    "border": { "base": "#51576d" },
    "scrollbar": { "base": "#626880" },
    "diff": {
      "text": {
        "added": "#a6d189",
        "removed": "#e78284",
        "context": "#a5adce",
        "hunkHeader": "#ef9f76"
      },
      "background": {
        "added": "#424b50",
        "removed": "#4b3f50",
        "context": "#292c3c"
      },
      "highlight": {
        "added": "#a6d189",
        "removed": "#e78284"
      },
      "lineNumber": {
        "text": "#626880",
        "background": {
          "added": "#3c444d",
          "removed": "#433c4c"
        }
      }
    },
    "syntax": {
      "comment": "#949cbb",
      "keyword": "#f2d5cf",
      "function": "#8caaee",
      "variable": "#e78284",
      "string": "#a6d189",
      "number": "#ef9f76",
      "type": "#e5c890",
      "operator": "#99d1db",
      "punctuation": "#c6d0f5"
    },
    "markdown": {
      "text": "#c6d0f5",
      "heading": "#f2d5cf",
      "link": "#8caaee",
      "linkText": "#99d1db",
      "code": "#a6d189",
      "blockQuote": "#e5c890",
      "emphasis": "#e5c890",
      "strong": "#ef9f76",
      "horizontalRule": "#a5adce",
      "listItem": "#8caaee",
      "listEnumeration": "#99d1db",
      "image": "#8caaee",
      "imageText": "#99d1db",
      "codeBlock": "#c6d0f5"
    },
    "@dialog": {
      "background": {
        "base": "$background.raised.base",
        "action": {
          "primary": { "$hovered": "$background.raised.max" },
          "secondary": { "$hovered": "$background.raised.max" }
        }
      },
      "@footer": {
        "text": { "muted": "$hue.neutral.200" }
      }
    }
  },
  "dark": {
    "hue": {
      "neutral": {
        "100": "#c6d0f5",
        "200": "#b5bfe2",
        "300": "#a5adce",
        "400": "#838ba7",
        "500": "#626880",
        "600": "#51576d",
        "700": "#414559",
        "800": "#303446",
        "900": "#292c3c"
      },
