{
  "$schema": "https://opencode.ai/theme.json",
  "base": {
    "categorical": ["accent", "purple", "green", "blue", "orange", "red"],
    "text": {
      "base": "$hue.neutral.100",
      "muted": "$hue.neutral.300",
      "action": {
        "primary": {
          "base": "$text.base",
          "$disabled": "$text.muted",
          "$focused": "$text.base",
          "$selected": "$hue.interactive.400"
        },
        "secondary": {
          "base": "$text.muted",
          "$hovered": "$text.base",
          "$focused": "$hue.interactive.200"
        },
        "destructive": {
          "base": "$hue.neutral.900",
          "$disabled": "$text.muted"
        }
      },
      "formfield": {
        "base": "$text.base",
        "$hovered": "$hue.interactive.400",
        "$focused": "$hue.interactive.400",
        "$pressed": "$hue.interactive.400",
        "$disabled": "$text.muted",
        "$selected": "$hue.interactive.400"
      },
      "feedback": {
        "error": { "base": "$hue.red.400" },
        "warning": { "base": "$hue.yellow.400" },
        "success": { "base": "$hue.green.400" },
        "info": { "base": "$hue.teal.400" }
      }
    },
    "background": {
      "base": "#eff1f5",
      "raised": {
        "base": "#e6e9ef",
        "high": "#dce0e8",
        "max": "#ccd0da"
      },
      "action": {
        "primary": {
          "base": "transparent",
          "$hovered": "$hue.neutral.700",
          "$focused": "$hue.interactive.600",
          "$selected": "transparent"
        },
        "secondary": { "base": "transparent" },
        "destructive": { "base": "$hue.red.400" }
      },
      "formfield": { "base": "$background.base" },
      "feedback": {
        "error": { "base": "$background.base" },
        "warning": { "base": "$background.base" },
        "success": { "base": "$background.base" },
        "info": { "base": "$background.base" }
      }
    },
    "border": { "base": "#bcc0cc" },
    "scrollbar": { "base": "#acb0be" },
    "diff": {
      "text": {
        "added": "#40a02b",
        "removed": "#d20f39",
        "context": "#6c6f85",
        "hunkHeader": "#fe640b"
      },
      "background": {
        "added": "#d5e5d6",
        "removed": "#eacfd8",
        "context": "#e6e9ef"
      },
      "highlight": {
        "added": "#40a02b",
        "removed": "#d20f39"
      },
      "lineNumber": {
        "text": "#acb0be",
        "background": {
          "added": "#dee8e0",
          "removed": "#ecdae2"
        }
      }
    },
    "syntax": {
      "comment": "#7c7f93",
      "keyword": "#e64553",
      "function": "#1e66f5",
      "variable": "#d20f39",
      "string": "#40a02b",
      "number": "#fe640b",
      "type": "#df8e1d",
      "operator": "#04a5e5",
      "punctuation": "#4c4f69"
    },
    "markdown": {
      "text": "#4c4f69",
      "heading": "#e64553",
      "link": "#1e66f5",
      "linkText": "#04a5e5",
      "code": "#40a02b",
      "blockQuote": "#df8e1d",
      "emphasis": "#df8e1d",
      "strong": "#fe640b",
      "horizontalRule": "#6c6f85",
      "listItem": "#1e66f5",
      "listEnumeration": "#04a5e5",
      "image": "#1e66f5",
      "imageText": "#04a5e5",
      "codeBlock": "#4c4f69"
    },
    "@dialog": {
      "background": {
        "base": "$background.raised.base",
        "action": {
          "primary": { "$hovered": "$background.raised.max" },
          "secondary": { "$hovered": "$background.raised.max" }
        }
      },
      "@footer": {
        "text": { "muted": "$hue.neutral.200" }
      }
    }
  },
  "light": {
    "hue": {
      "neutral": {
        "100": "#4c4f69",
        "200": "#5c5f77",
        "300": "#6c6f85",
        "400": "#8c8fa1",
        "500": "#acb0be",
