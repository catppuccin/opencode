{
  "$schema": "https://opencode.ai/theme.json",
  "base": {
    "categorical": ["accent", "purple", "green", "blue", "orange", "red"],
    "text": {
      "base": "$hue.neutral.100",
      "muted": "$hue.neutral.300",
      "action": {
        "primary": {
          "base": "$text.base",
          "$disabled": "$text.muted",
          "$focused": "$text.base",
          "$selected": "$hue.interactive.400"
        },
        "secondary": {
          "base": "$text.muted",
          "$hovered": "$text.base",
          "$focused": "$hue.interactive.200"
        },
        "destructive": {
          "base": "$hue.neutral.900",
          "$disabled": "$text.muted"
        }
      },
      "formfield": {
        "base": "$text.base",
        "$hovered": "$hue.interactive.400",
        "$focused": "$hue.interactive.400",
        "$pressed": "$hue.interactive.400",
        "$disabled": "$text.muted",
        "$selected": "$hue.interactive.400"
      },
      "feedback": {
        "error": { "base": "$hue.red.400" },
        "warning": { "base": "$hue.yellow.400" },
        "success": { "base": "$hue.green.400" },
        "info": { "base": "$hue.teal.400" }
      }
    },
    "background": {
      "base": "#24273a",
      "raised": {
        "base": "#1e2030",
        "high": "#181926",
        "max": "#363a4f"
      },
      "action": {
        "primary": {
          "base": "transparent",
          "$hovered": "$hue.neutral.700",
          "$focused": "$hue.interactive.600",
          "$selected": "transparent"
        },
        "secondary": { "base": "transparent" },
        "destructive": { "base": "$hue.red.400" }
      },
      "formfield": { "base": "$background.base" },
      "feedback": {
        "error": { "base": "$background.base" },
        "warning": { "base": "$background.base" },
        "success": { "base": "$background.base" },
        "info": { "base": "$background.base" }
      }
    },
    "border": { "base": "#494d64" },
    "scrollbar": { "base": "#5b6078" },
    "diff": {
      "text": {
        "added": "#a6da95",
        "removed": "#ed8796",
        "context": "#a5adcb",
        "hunkHeader": "#f5a97f"
      },
      "background": {
        "added": "#384147",
        "removed": "#423547",
        "context": "#1e2030"
      },
      "highlight": {
        "added": "#a6da95",
        "removed": "#ed8796"
      },
      "lineNumber": {
        "text": "#5b6078",
        "background": {
          "added": "#313943",
          "removed": "#383143"
        }
      }
    },
    "syntax": {
      "comment": "#939ab7",
      "keyword": "#f5a97f",
      "function": "#8aadf4",
      "variable": "#ed8796",
      "string": "#a6da95",
      "number": "#f5a97f",
      "type": "#eed49f",
      "operator": "#91d7e3",
      "punctuation": "#cad3f5"
    },
    "markdown": {
      "text": "#cad3f5",
      "heading": "#f5a97f",
      "link": "#8aadf4",
      "linkText": "#91d7e3",
      "code": "#a6da95",
      "blockQuote": "#eed49f",
      "emphasis": "#eed49f",
      "strong": "#f5a97f",
      "horizontalRule": "#a5adcb",
      "listItem": "#8aadf4",
      "listEnumeration": "#91d7e3",
      "image": "#8aadf4",
      "imageText": "#91d7e3",
      "codeBlock": "#cad3f5"
    },
    "@dialog": {
      "background": {
        "base": "$background.raised.base",
        "action": {
          "primary": { "$hovered": "$background.raised.max" },
          "secondary": { "$hovered": "$background.raised.max" }
        }
      },
      "@footer": {
        "text": { "muted": "$hue.neutral.200" }
      }
    }
  },
  "dark": {
    "hue": {
      "neutral": {
        "100": "#cad3f5",
        "200": "#b8c0e0",
        "300": "#a5adcb",
        "400": "#8087a2",
        "500": "#5b6078",
        "600": "#494d64",
        "700": "#363a4f",
        "800": "#24273a",
        "900": "#1e2030"
      },
