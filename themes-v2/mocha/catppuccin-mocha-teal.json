{
  "$schema": "https://opencode.ai/theme.json",
  "base": {
    "categorical": ["accent", "purple", "green", "blue", "orange", "red"],
    "text": {
      "base": "$hue.neutral.100",
      "muted": "$hue.neutral.300",
      "action": {
        "primary": {
          "base": "$text.base",
          "$disabled": "$text.muted",
          "$focused": "$text.base",
          "$selected": "$hue.interactive.400"
        },
        "secondary": {
          "base": "$text.muted",
          "$hovered": "$text.base",
          "$focused": "$hue.interactive.200"
        },
        "destructive": {
          "base": "$hue.neutral.900",
          "$disabled": "$text.muted"
        }
      },
      "formfield": {
        "base": "$text.base",
        "$hovered": "$hue.interactive.400",
        "$focused": "$hue.interactive.400",
        "$pressed": "$hue.interactive.400",
        "$disabled": "$text.muted",
        "$selected": "$hue.interactive.400"
      },
      "feedback": {
        "error": { "base": "$hue.red.400" },
        "warning": { "base": "$hue.yellow.400" },
        "success": { "base": "$hue.green.400" },
        "info": { "base": "$hue.teal.400" }
      }
    },
    "background": {
      "base": "#1e1e2e",
      "raised": {
        "base": "#181825",
        "high": "#11111b",
        "max": "#313244"
      },
      "action": {
        "primary": {
          "base": "transparent",
          "$hovered": "$hue.neutral.700",
          "$focused": "$hue.interactive.600",
          "$selected": "transparent"
        },
        "secondary": { "base": "transparent" },
        "destructive": { "base": "$hue.red.400" }
      },
      "formfield": { "base": "$background.base" },
      "feedback": {
        "error": { "base": "$background.base" },
        "warning": { "base": "$background.base" },
        "success": { "base": "$background.base" },
        "info": { "base": "$background.base" }
      }
    },
    "border": { "base": "#45475a" },
    "scrollbar": { "base": "#585b70" },
    "diff": {
      "text": {
        "added": "#a6e3a1",
        "removed": "#f38ba8",
        "context": "#a6adc8",
        "hunkHeader": "#fab387"
      },
      "background": {
        "added": "#333c3f",
        "removed": "#3e2f40",
        "context": "#181825"
      },
      "highlight": {
        "added": "#a6e3a1",
        "removed": "#f38ba8"
      },
      "lineNumber": {
        "text": "#585b70",
        "background": {
          "added": "#2c3239",
          "removed": "#34293a"
        }
      }
    },
    "syntax": {
      "comment": "#9399b2",
      "keyword": "#94e2d5",
      "function": "#89b4fa",
      "variable": "#f38ba8",
      "string": "#a6e3a1",
      "number": "#fab387",
      "type": "#f9e2af",
      "operator": "#89dceb",
      "punctuation": "#cdd6f4"
    },
    "markdown": {
      "text": "#cdd6f4",
      "heading": "#94e2d5",
      "link": "#89b4fa",
      "linkText": "#89dceb",
      "code": "#a6e3a1",
      "blockQuote": "#f9e2af",
      "emphasis": "#f9e2af",
      "strong": "#fab387",
      "horizontalRule": "#a6adc8",
      "listItem": "#89b4fa",
      "listEnumeration": "#89dceb",
      "image": "#89b4fa",
      "imageText": "#89dceb",
      "codeBlock": "#cdd6f4"
    },
    "@dialog": {
      "background": {
        "base": "$background.raised.base",
        "action": {
          "primary": { "$hovered": "$background.raised.max" },
          "secondary": { "$hovered": "$background.raised.max" }
        }
      },
      "@footer": {
        "text": { "muted": "$hue.neutral.200" }
      }
    }
  },
  "dark": {
    "hue": {
      "neutral": {
        "100": "#cdd6f4",
        "200": "#bac2de",
        "300": "#a6adc8",
        "400": "#7f849c",
        "500": "#585b70",
        "600": "#45475a",
